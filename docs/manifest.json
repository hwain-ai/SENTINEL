  ],
  "rules": [
    {
      "id": "readme-usage",
      "sources": [
        "src/sentinel/cli.py",
        "src/sentinel/diagnostics.py",
        "src/sentinel/protocol.py",
        "src/sentinel/gate.py",
        "src/sentinel/setup.py",
        "src/sentinel/bundle.py",
        "pyproject.toml"
      ],
      "documents": [
        "README.md"
      ]
    },
    {
      "id": "runner",
      "sources": [
        "src/sentinel/**"
      ],
      "documents": [
        "docs/references/sentinel-cli-reference.md"
      ]
    },
    {
      "id": "results",
      "sources": [
        "src/sentinel/cli.py",
        "src/sentinel/diagnostics.py",
        "src/sentinel/protocol.py",
        "src/sentinel/gate.py"
      ],
      "documents": [
        "docs/results.md"
      ]
    },
    {
      "id": "setup",
      "sources": [
        "src/sentinel/setup.py",
        "src/sentinel/bundle.py",
        "pyproject.toml"
      ],
      "documents": [
        "README.md",
        "plugins/sentinel/skills/sentinel/references/setup.md"
      ]
    },
    {
      "id": "admission",
      "sources": [
        "src/sentinel/admission.py",
        "src/sentinel/admission.json",
        "scripts/admission.py"
      ],
      "documents": [
        "docs/references/sentinel-cli-reference.md"
      ]
    },
    {
      "id": "plugin",
      "sources": [
        ".agents/plugins/*.json",
        ".claude-plugin/*.json",
        "plugins/sentinel/.claude-plugin/*.json",
        "plugins/sentinel/.codex-plugin/*.json"
      ],
      "documents": [
        "plugins/sentinel/README.md",
        "plugins/sentinel/skills/sentinel/SKILL.md"
      ]
    },
    {
      "id": "documentation-checks",
      "sources": [
        "scripts/docs_lint.py",
        "scripts/verify_repository.sh",
        ".githooks/**",
        ".github/workflows/**",
        "docs/manifest.json",
        "tests/test_docs_lint.py",
        "scripts/verify_native.py"
      ],
      "documents": [
        "docs/contributing.md"
      ]
    },
    {
      "id": "agent-context",
      "sources": [
        "src/sentinel/cli.py",
        "src/sentinel/selection.py"
      ],
      "documents": [
        "plugins/sentinel/skills/sentinel/SKILL.md"
      ]
    },
    {
      "id": "engine-guide",
      "sources": [
        "src/sentinel/setup.py",
        "src/sentinel/admission.json"
      ],
      "documents": [
        "docs/references/sentinel-quality-tools-reference.md"
      ]
    },
    {
      "id": "start-context",
      "sources": [
        "src/sentinel/setup.py",
        "src/sentinel/gate.py",
        "plugins/sentinel/skills/sentinel/references/setup.md"
      ],
      "documents": [
        "plugins/sentinel/skills/start/SKILL.md"
      ]
    },
    {
      "id": "skill-usage",
      "sources": [
        "plugins/sentinel/skills/*/SKILL.md",
        "plugins/sentinel/skills/sentinel/references/*.md"
      ],
      "documents": [
        "README.md"
      ]
    },
    {
      "id": "experiment-record",
      "sources": [
        "docs/evidence/*.pdf"
      ],
      "documents": [
        "docs/evidence/quality-goals-study.md"
      ]
    },
    {
      "id": "experiment-readme",
      "sources": [
        "docs/evidence/*.pdf"
      ],
      "documents": [
        "README.md"
      ]
    }
  ],
  "ignoreDocuments": []
}
